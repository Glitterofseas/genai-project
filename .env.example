OPENAI_API_KEY=sk-proj-REPLACE_ME
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Schedule DB. Default backend is the committed SQLite fixture (option C).
SCHEDULE_BACKEND=sqlite
SQLITE_PATH=data/schedule.sqlite
MSSQL_CONN=Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=Tech;Trusted_Connection=yes;

# Written by app/modules/fine_tuning after a job completes (also mirrored to a committed json).
EXIT_ADVISOR_MODEL=
